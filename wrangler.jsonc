{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "laraclaw-docs",
  "compatibility_date": "2026-08-13",
  "assets": {
    // nuxt generate writes the fully prerendered site here.
    "directory": ".output/public",
    // Serve the prerendered 404.html for unknown paths rather than falling
    // back to the SPA shell, so a bad URL is a real 404 for crawlers.
    "not_found_handling": "404-page"
  }
}
